/*
 * AXI ComBlock control loop with UART command interface
 * (Robust, non-blocking binary protocol version)
 */

#include "comblock.h"
#include "xparameters.h"
#include "xuartps.h"

#define AXIL_BASE   XPAR_COMBLOCK_0_AXIL_BASEADDR
#define AXIF_BASE   XPAR_COMBLOCK_0_AXIF_BASEADDR

#define UART_DEVICE_ID XPAR_XUARTPS_0_DEVICE_ID

#define SYNC_BYTE 0xAA

/* Command IDs */
#define CMD_WRITE_OREG       0x01
#define CMD_READ_IREG        0x02
#define CMD_WRITE_OFIFO      0x03
#define CMD_WRITE_OFIFO_BULK 0x05
#define CMD_ACK              0x10
#define CMD_NACK             0x11
#define CMD_DATA             0x12

#define MAX_SAMPLES 1024
#define SAMPLE_MASK 0x00FFFFFF  /* 24-bit samples */

/* Max payload: 4 (count) + MAX_SAMPLES*3 bytes (24-bit packed) */
#define MAX_PAYLOAD (4 + MAX_SAMPLES*3)

static XUartPs Uart;

/* ---------------- Low-level byte I/O ---------------- */

static void uart_send_byte(u8 b) {
    XUartPs_SendByte(XPAR_XUARTPS_0_BASEADDR, b);
}

/* Returns 0 on success, -1 on timeout */
static int uart_recv_byte_timeout(u8 *b) {
    u32 timeout = 50000000; /* Tune based on CPU clock (e.g., ~0.5s) */
    while (!XUartPs_IsReceiveData(XPAR_XUARTPS_0_BASEADDR)) {
        if (--timeout == 0) {
            return -1;
        }
    }
    *b = XUartPs_ReadReg(XPAR_XUARTPS_0_BASEADDR, XUARTPS_FIFO_OFFSET);
    return 0;
}

/* ---------------- Frame send/receive ---------------- */

static void send_frame(u8 cmd, u8 *payload, u16 len) {
    u8 len_lo = len & 0xFF;
    u8 len_hi = (len >> 8) & 0xFF;
    u8 cs;
    int i;

    uart_send_byte(SYNC_BYTE);
    uart_send_byte(cmd);
    uart_send_byte(len_lo);
    uart_send_byte(len_hi);
    for (i = 0; i < len; i++) uart_send_byte(payload[i]);

    cs = cmd ^ len_lo ^ len_hi;
    for (i = 0; i < len; i++) cs ^= payload[i];
    uart_send_byte(cs);
}

/* Blocking receive with timeout. payload buffer must be >= MAX_PAYLOAD */
static int recv_frame(u8 *cmd, u8 *payload, u16 *len) {
    u8 b, cs, len_lo, len_hi;
    int i;

    /* Wait for SYNC_BYTE or timeout */
    do {
        if (uart_recv_byte_timeout(&b) < 0) return -1;
    } while (b != SYNC_BYTE);

    if (uart_recv_byte_timeout(cmd) < 0) return -1;
    if (uart_recv_byte_timeout(&len_lo) < 0) return -1;
    if (uart_recv_byte_timeout(&len_hi) < 0) return -1;
    *len = ((u16)len_hi << 8) | len_lo;

    if (*len > MAX_PAYLOAD) return -1; /* sanity guard */

    for (i = 0; i < *len; i++) {
        if (uart_recv_byte_timeout(&payload[i]) < 0) return -1;
    }

    if (uart_recv_byte_timeout(&cs) < 0) return -1;

    u8 calc = (*cmd) ^ len_lo ^ len_hi;
    for (i = 0; i < *len; i++) calc ^= payload[i];

    if (calc != cs) return -1;
    return 0;
}

/* ---------------- Register/FIFO helpers ---------------- */

static inline int read_input_reg(int index) {
    return cbRead(AXIL_BASE, index);
}

static inline void write_output_reg(int index, int value) {
    cbWrite(AXIL_BASE, CB_OREG0 + index, value);
}

static inline void write_output_fifo(int value) {
    cbWrite(AXIL_BASE, CB_OFIFO_VALUE, value & SAMPLE_MASK);
}

static void put_u32(u8 *buf, u32 val) {
    buf[0] = val & 0xFF;
    buf[1] = (val >> 8) & 0xFF;
    buf[2] = (val >> 16) & 0xFF;
    buf[3] = (val >> 24) & 0xFF;
}

static u32 get_u32(u8 *buf) {
    return (u32)buf[0] | ((u32)buf[1] << 8) |
           ((u32)buf[2] << 16) | ((u32)buf[3] << 24);
}

static u32 get_u24(u8 *buf) {
    return (u32)buf[0] | ((u32)buf[1] << 8) | ((u32)buf[2] << 16);
}

/* ---------------- Command dispatcher ---------------- */

static void process_command(u8 cmd, u8 *payload, u16 len) {
    u8 out[4];
    u32 val;
    u8 idx;

    switch (cmd) {
    case CMD_WRITE_OREG:
        if (len != 5) { send_frame(CMD_NACK, NULL, 0); break; }
        idx = payload[0];
        val = get_u32(&payload[1]);
        write_output_reg(idx, val);
        send_frame(CMD_ACK, NULL, 0);
        break;

    case CMD_READ_IREG:
        if (len != 1) { send_frame(CMD_NACK, NULL, 0); break; }
        idx = payload[0];
        val = read_input_reg(idx);
        put_u32(out, val);
        send_frame(CMD_DATA, out, 4);
        break;

    case CMD_WRITE_OFIFO:
        if (len != 3) { send_frame(CMD_NACK, NULL, 0); break; }
        val = get_u24(payload);
        write_output_fifo(val);
        send_frame(CMD_ACK, NULL, 0);
        break;

    case CMD_WRITE_OFIFO_BULK: {
        u32 count, i;
        if (len < 4) { send_frame(CMD_NACK, NULL, 0); break; }
        count = get_u32(payload);
        if (count > MAX_SAMPLES || (u32)(4 + count*3) != len) {
            send_frame(CMD_NACK, NULL, 0);
            break;
        }
        for (i = 0; i < count; i++) {
            val = get_u24(&payload[4 + i*3]);
            write_output_fifo(val);
        }
        send_frame(CMD_ACK, NULL, 0);
        break;
    }

    default:
        send_frame(CMD_NACK, NULL, 0);
        break;
    }
}

/* ---------------- Main loop ---------------- */

int main() {
    int Status;
    XUartPs_Config *Config;
    u8 cmd;
    u16 len;
    static u8 payload[MAX_PAYLOAD];

    Config = XUartPs_LookupConfig(UART_DEVICE_ID);
    if (Config == NULL) return XST_FAILURE;

    Status = XUartPs_CfgInitialize(&Uart, Config, Config->BaseAddress);
    if (Status != XST_SUCCESS) return XST_FAILURE;

    /* Bumped to 921600 for rapid bulk transfer */
    XUartPs_SetBaudRate(&Uart, 921600);

    while (1) {
        if (recv_frame(&cmd, payload, &len) == 0) {
            process_command(cmd, payload, len);
        } else {
            /* If we timed out or got a bad frame, flush the RX FIFO to reset state */
            while (XUartPs_IsReceiveData(XPAR_XUARTPS_0_BASEADDR)) {
                XUartPs_ReadReg(XPAR_XUARTPS_0_BASEADDR, XUARTPS_FIFO_OFFSET);
            }
        }
    }

    return 0;
}
